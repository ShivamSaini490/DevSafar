APP_NAME=DevSafar API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_MINUTES=60
ACCESS_TOKEN_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
MAX_REQUEST_BODY_BYTES=1048576

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=devsafar
POSTGRES_USER=devsafar
POSTGRES_PASSWORD=replace-with-local-dev-password

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=10

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional smaller model for grounded attraction extraction. Empty uses GROQ_MODEL.
GROQ_EXTRACTION_MODEL=
# Optional second model for the final plain-JSON extraction fallback.
GROQ_EXTRACTION_FALLBACK_MODEL=
# Extraction completion budget includes hidden reasoning tokens on reasoning models.
GROQ_EXTRACTION_MAX_COMPLETION_TOKENS=4096
# Used once when an empty completion stops because the first budget was exhausted.
GROQ_EXTRACTION_RETRY_MAX_COMPLETION_TOKENS=8192
# GPT-OSS supports low, medium, or high; low is appropriate for bounded extraction.
GROQ_EXTRACTION_REASONING_EFFORT=low
# Keep reasoning text out of extraction responses and logs.
GROQ_EXTRACTION_INCLUDE_REASONING=false
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRY_WAIT_SECONDS=8
GRAPH_TIMEOUT_SECONDS=60
MAPS_PROVIDER=stub
# Public OSRM is testing-only; use an allowlisted production deployment for production.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=DevSafar/0.1 road-routing-backend
NOMINATIM_COUNTRY_CODE=in
MAPS_ALLOWED_HOSTS=router.project-osrm.org,nominatim.openstreetmap.org
MAPS_HTTP_TIMEOUT_SECONDS=10
GEOCODE_CACHE_TTL_SECONDS=2592000
# SerpApi is opt-in. Keep the key empty here; configure it only in the owner's environment.
GOOGLE_SERP_API_KEY=
SERPAPI_ENABLED=false
SERPAPI_MONTHLY_BUDGET=250
SERPAPI_MAX_SEARCHES_PER_TRIP=3
FLIGHT_CACHE_TTL_SECONDS=900
HOTEL_CACHE_TTL_SECONDS=1800
PRICE_HISTORY_ENABLED=true
PRICE_HISTORY_MAX_AGE_DAYS=90
PRICE_HISTORY_RETENTION_DAYS=180
ALLOW_DEMO_PRICE_DATA=false
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_ALLOWED_HOSTS=api.tavily.com
# Basic search costs 1 Tavily credit; cap is per trip and cache misses only.
TAVILY_MAX_SEARCHES_PER_TRIP=2
TAVILY_CACHE_TTL_SECONDS=604800
TAVILY_NEGATIVE_CACHE_TTL_SECONDS=120
TAVILY_TIMEOUT_SECONDS=10
TAVILY_SNIPPETS_FOR_EXTRACTION=4
ATTRACTION_SNIPPET_MAX_CHARS=700
# Social/video domains are excluded before Groq sees any snippets.
TAVILY_EXCLUDED_DOMAINS=youtube.com,youtu.be,facebook.com,instagram.com,tiktok.com,x.com,pinterest.com
ATTRACTIONS_PER_DESTINATION=6
# Exact HTTPS hosts permitted for plain booking search-page redirects.
BOOKING_ALLOWED_HOSTS=www.irctc.co.in,www.makemytrip.com,www.redbus.in,www.google.com,www.booking.com
# PLACEHOLDER - owner must verify against official sources.
# Every fare, speed, overhead, hotel, food, and local-transport value below is
# configurable estimation input only. It is not an official fare or timetable.
FUEL_COST_PER_KM=12.00
ESTIMATE_TRAIN_SLEEPER_INR_PER_KM=0.75
ESTIMATE_TRAIN_3AC_INR_PER_KM=1.50
ESTIMATE_TRAIN_2AC_INR_PER_KM=2.25
ESTIMATE_BUS_ORDINARY_INR_PER_KM=1.20
ESTIMATE_BUS_AC_INR_PER_KM=2.00
ESTIMATE_BUS_SLEEPER_INR_PER_KM=2.50
ESTIMATE_FLIGHT_BASE_MIN_INR=2500
ESTIMATE_FLIGHT_BASE_MAX_INR=4500
ESTIMATE_FLIGHT_PER_KM_MIN_INR=3.00
ESTIMATE_FLIGHT_PER_KM_MAX_INR=7.00
ESTIMATE_FLIGHT_MIN_FARE_MIN_INR=3000
ESTIMATE_FLIGHT_MIN_FARE_MAX_INR=5000
ESTIMATE_ROAD_SPEED_MIN_KMPH=40
ESTIMATE_ROAD_SPEED_MAX_KMPH=65
ESTIMATE_TRAIN_SPEED_MIN_KMPH=45
ESTIMATE_TRAIN_SPEED_MAX_KMPH=70
ESTIMATE_BUS_SPEED_MIN_KMPH=35
ESTIMATE_BUS_SPEED_MAX_KMPH=55
ESTIMATE_FLIGHT_SPEED_MIN_KMPH=650
ESTIMATE_FLIGHT_SPEED_MAX_KMPH=800
ESTIMATE_TRAIN_OVERHEAD_MIN_HOURS=1
ESTIMATE_TRAIN_OVERHEAD_MAX_HOURS=2
ESTIMATE_BUS_OVERHEAD_MIN_HOURS=0.5
ESTIMATE_BUS_OVERHEAD_MAX_HOURS=1
ESTIMATE_FLIGHT_OVERHEAD_MIN_HOURS=3
ESTIMATE_FLIGHT_OVERHEAD_MAX_HOURS=5
ESTIMATE_TRAIN_DISTANCE_THRESHOLD_KM=100
ESTIMATE_HOTEL_BUDGET_MIN_INR=1000
ESTIMATE_HOTEL_BUDGET_MAX_INR=1800
ESTIMATE_HOTEL_STANDARD_MIN_INR=2000
ESTIMATE_HOTEL_STANDARD_MAX_INR=3500
ESTIMATE_HOTEL_COMFORT_MIN_INR=4000
ESTIMATE_HOTEL_COMFORT_MAX_INR=6500
ESTIMATE_FOOD_MIN_PER_DAY_PER_TRAVELER=400
ESTIMATE_FOOD_MAX_PER_DAY_PER_TRAVELER=800
ESTIMATE_LOCAL_TRANSPORT_MIN_PER_DAY_PER_TRAVELER=250
ESTIMATE_LOCAL_TRANSPORT_MAX_PER_DAY_PER_TRAVELER=600
MAX_DRIVING_HOURS_PER_DAY=10
# India-time clock cutoff: driving can resume at 06:00 but may not continue past this hour.
DRIVING_LATEST_ARRIVAL_HOUR=21
MIN_STAY_HOURS_PER_DESTINATION=6
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=devsafar_travel_knowledge
RAG_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Mount this directory as a persistent volume in containers.
EMBEDDING_CACHE_DIR=
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.45
RAG_TIMEOUT_SECONDS=8
RAG_MODEL_LOAD_TIMEOUT_SECONDS=180
RAG_CACHE_TTL_SECONDS=3600

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=replace-with-full-smtp-login-address
SMTP_PASSWORD=
# true means implicit TLS (normally port 465); false means STARTTLS (normally port 587).
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=
DEV_OTP_EMAIL_FALLBACK_ENABLED=false

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_GRANT_EXPIRY_MINUTES=10

TEMPORARY_CHAT_TTL_SECONDS=1800
TEMPORARY_CHAT_MAX_MESSAGES=20
TEMPORARY_CHAT_MAX_BYTES=65536
TEMPORARY_CHAT_RATE_LIMIT_PER_IP=30
TEMPORARY_CHAT_RATE_LIMIT_PER_SESSION=20
TEMPORARY_CHAT_RATE_LIMIT_WINDOW_SECONDS=60

PLANNING_RUNS_PER_HOUR=10
PLANNING_RUNS_PER_DAY=40
PLANNING_RUNS_PER_HOUR_GUEST=5
PLANNING_RUNS_PER_TEMP_SESSION=10
PLANNING_MAX_CONCURRENT=3
PLANNING_STREAM_MAX_SECONDS=120
PLANNING_STREAM_TTL_SECONDS=600
PLANNING_STREAM_HEARTBEAT_SECONDS=15
# 0 means unlimited. Counters are Redis-backed and contain no prompt text.
GROQ_DAILY_CALL_BUDGET=1000
TAVILY_DAILY_SEARCH_BUDGET=200

CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=900
CLEANUP_BATCH_SIZE=100

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devsafar
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
