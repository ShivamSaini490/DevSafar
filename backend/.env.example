APP_NAME=DevSafar API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_MINUTES=60
ACCESS_TOKEN_COOKIE_NAME=access_token
CSRF_COOKIE_NAME=csrf_token

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=devsafar
POSTGRES_USER=devsafar
POSTGRES_PASSWORD=replace-with-local-dev-password

REDIS_URL=redis://127.0.0.1:6379/0

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GRAPH_TIMEOUT_SECONDS=60
MAPS_PROVIDER=stub
# Public OSRM is testing-only; use an allowlisted production deployment for production.
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=DevSafar/0.1 road-routing-backend
NOMINATIM_COUNTRY_CODE=in
MAPS_ALLOWED_HOSTS=router.project-osrm.org,nominatim.openstreetmap.org
MAPS_HTTP_TIMEOUT_SECONDS=10
GEOCODE_CACHE_TTL_SECONDS=2592000
FUEL_COST_PER_KM=12.00
MAX_DRIVING_HOURS_PER_DAY=10
# India-time clock cutoff: driving can resume at 06:00 but may not continue past this hour.
DRIVING_LATEST_ARRIVAL_HOUR=21
MIN_STAY_HOURS_PER_DESTINATION=6
QDRANT_URL=
QDRANT_API_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=replace-with-full-smtp-login-address
SMTP_PASSWORD=
# true means implicit TLS (normally port 465); false means STARTTLS (normally port 587).
SMTP_USE_TLS=false
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=
DEV_OTP_EMAIL_FALLBACK_ENABLED=false

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
RESET_GRANT_EXPIRY_MINUTES=10

TEMPORARY_CHAT_TTL_SECONDS=1800
TEMPORARY_CHAT_MAX_MESSAGES=20
TEMPORARY_CHAT_MAX_BYTES=65536
TEMPORARY_CHAT_RATE_LIMIT_PER_IP=30
TEMPORARY_CHAT_RATE_LIMIT_PER_SESSION=20
TEMPORARY_CHAT_RATE_LIMIT_WINDOW_SECONDS=60

CLEANUP_ENABLED=true
CLEANUP_INTERVAL_SECONDS=900
CLEANUP_BATCH_SIZE=100

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=devsafar
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
